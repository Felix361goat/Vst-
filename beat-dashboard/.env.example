# Kopiere diese Datei nach .env (macht start.bat automatisch) oder trage die Keys im Dashboard unter "Einstellungen" ein.
# Alles ist optional - ohne Keys laeuft das Dashboard mit kostenlosen Quellen.

# YouTube Data API v3 (kostenlos, 10.000 Einheiten/Tag): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Wie viele YouTube-Einheiten das Dashboard pro Tag maximal verbrauchen darf
YT_DAILY_BUDGET=8000
# search.list hat seit 2026 ein eigenes Limit (~100 Aufrufe/Tag)
YT_SEARCH_BUDGET=90

# Last.fm API (kostenlos): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Anthropic / Claude (optional, kostenpflichtig): https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Region/Sprache fuer YouTube-Suchen
REGION_CODE=US
PORT=8765

# Deine Daten fuer Beschreibungs-Vorlagen
PRODUCER_NAME=
STORE_LINK=
INSTAGRAM=
